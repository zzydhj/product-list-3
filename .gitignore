# 上线内容一律由 node tools/publish.mjs 生成，不提交
dist/

# 数据备份（每次保存自动滚动，最多 20 份，只留在本机）
tools/*.bak-*
# 回滚前拍的成对快照（最多留 5 组）
tools/*.pre-restore-*
# 生成器上一轮往页面写了哪些型号（护栏用它区分「自己写的」与「人手加的」）
tools/last-build.json

# 本地验证时拍的管理界面截图（不是站点资源，也不进部署目录）
/*.png
# 但站点图标是页面里真在引的资源，必须进仓库、必须进 dist：
# 不反向放行的话，本机能看到的 /favicon.png 与 /apple-touch-icon.png 在线上会直接 404
#（publish 对缺文件只打「[提示]」不拦，所以这种漏不会报错，只会静默少东西）
!/favicon.png
!/apple-touch-icon.png

# tools/download-cgc.mjs 的输出目录：从图床拉回来的原始副本，只用于人工上传，
# 既不是站点资源也进不了 dist；不忽略的话跑一次脚本就会往仓库根堆十几张 JPG
/CGC-images/

# 依赖与系统文件
node_modules/
.idea/
.vscode/
Thumbs.db
.DS_Store
